# Server-only secrets. Never expose these through NEXT_PUBLIC_* variables.
SUPABASE_URL=https://jfvbikivtpfjgfsnggiz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Protects the scan endpoint when invoked by Supabase Cron.
CRON_SECRET=

# Binance public Futures REST API; no account or trading key is needed.
BINANCE_API_BASE_URL=https://fapi.binance.com
# Optional global spacing between REST requests. Increase for large historical downloads on free/public API limits.
BINANCE_REQUEST_DELAY_MS=0

# Gmail SMTP with a Google App Password.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_RECIPIENT=

# Project defaults. Values can be changed without code edits.
CS_DEFAULT_TIMEZONE=Asia/Shanghai
CS_SCAN_TIMEFRAMES=15m,1h,4h
CS_TOP_SYMBOLS=100
CS_SCAN_BATCH_SIZE=25
CS_MAX_EMAILS_PER_SCAN=6
CS_MIN_SIGNAL_SCORE=70
CS_SIGNAL_SIDE_FILTER=SHORT
CS_SIGNAL_STRATEGY_FAMILY=TREND
CS_REQUIRE_REGIME_ALIGNMENT=true
CS_STRATEGY_STOP_ATR_MULTIPLIER=0.5
CS_REWARD_RISK=2
CS_RISK_PER_TRADE_USDT=50
CS_MAX_POSITION_NOTIONAL_USDT=2000
CS_MAX_CONCURRENT_POSITIONS=1
CS_COOLDOWN_HOURS=8
CS_ENTRY_INTERVAL_HOURS=1
CS_MAX_EXECUTION_COST_RISK_FRACTION=0.1
CS_REQUEST_CONCURRENCY=5
CS_MARGIN_USDT=100
CS_PER_SIGNAL_RISK_CAP_USDT=100
CS_DAILY_RISK_BUDGET_USDT=600
CS_ASSUMED_LEVERAGE=20
CS_NEW_EMAIL_DAILY_CAP=10
CS_MAX_HOLD_HOURS=72
CS_INITIAL_PAPER_CAPITAL_USDT=10000
CS_PAPER_TRADING_ENABLED=true
CS_PAPER_TAKER_FEE_RATE=0.0004
CS_PAPER_SLIPPAGE_BPS=2
CS_PAPER_SETTLEMENT_BATCH_SIZE=100
CS_SHADOW_TRADING_ENABLED=true
CS_DRY_RUN=true

# Local-only historical data directory used by the monthly optimizer.
CS_OPTIMIZER_DATA_DIR=data/raw

# Validation/backtest universe. Defaults to the top 50 USDT-M perpetuals by 24h quote volume; use 100 for top 100.
CS_VALIDATION_SYMBOL_COUNT=50
CS_BACKTEST_SYMBOL_COUNT=50
# Optional frozen JSON manifest for reproducible comparisons.
# CS_VALIDATION_UNIVERSE_FILE=data/validation-universe-50.json

# Optional local history downloader. Keep the symbol list bounded on free plans.
CS_HISTORY_SYMBOLS=BTCUSDT,ETHUSDT
CS_HISTORY_DAYS=400
CS_HISTORY_TIMEFRAMES=15m,1h,4h
CS_HISTORY_CONCURRENCY=2
